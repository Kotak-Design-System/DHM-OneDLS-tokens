{
  "name": "onedl-design-tokens-test",
  "version": "1.0.0",
  "description": "Figma Variables tokens generated by DHM Tokens",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-tokens.mjs",
    "validate": "node scripts/build-tokens.mjs --check"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./typography.css": "./dist/typography.css",
    "./tokens.json": "./dist/tokens.resolved.json",
    "./manifest.json": "./dist/manifest.json"
  }
}
